# ---- Server ----
# Vercel manages the port automatically; only used when running locally.
PORT=5000
NODE_ENV=production

# ---- Authentication ----
# Use a long, random string in production.
JWT_SECRET=change_me_to_a_long_random_secret

# ---- Database (MySQL) ----
DB_TYPE=mysql
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=project_management
# Set to true if your MySQL provider requires TLS (Aiven, TiDB Cloud, Clever Cloud, ...)
DB_SSL=true

# ---- Alternative: SQLite (local development only) ----
# NOTE: SQLite does NOT persist on serverless hosts (Vercel). Do not use in production.
# DB_TYPE=sqlite
# DATABASE_FILE=./database.sqlite
